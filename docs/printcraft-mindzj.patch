+/// If MindZJ opened this document, return its expected original filename.
+#[cfg(target_arch = "wasm32")]
+fn mindzj_target_name() -> Option<String> {
+    let search = web_sys::window()?.location().search().ok()?;
+    let params = web_sys::UrlSearchParams::new_with_str(&search).ok()?;
+    params.get("mindzj_token")?;
+    params.get("mindzj_filename")
+}
+
+/// Send the saved PDF back to the embedding MindZJ tab instead of downloading it.
+#[cfg(target_arch = "wasm32")]
+fn save_to_mindzj(name: &str, bytes: &[u8]) -> Result<(), String> {
+    use wasm_bindgen::JsValue;
+    let search = web_sys::window().ok_or("no window")?.location().search().map_err(|e| format!("{e:?}"))?;
+    let params = web_sys::UrlSearchParams::new_with_str(&search).map_err(|e| format!("{e:?}"))?;
+    let token = params.get("mindzj_token").ok_or("missing MindZJ save token")?;
+    let channel = web_sys::BroadcastChannel::new(&format!("mindzj-printcraft:{token}")).map_err(|e| format!("{e:?}"))?;
+    let message = js_sys::Object::new();
+    js_sys::Reflect::set(&message, &"type".into(), &"saved-file".into()).map_err(|e| format!("{e:?}"))?;
+    js_sys::Reflect::set(&message, &"fileName".into(), &JsValue::from_str(name)).map_err(|e| format!("{e:?}"))?;
+    let data = js_sys::Uint8Array::from(bytes);
+    js_sys::Reflect::set(&message, &"bytes".into(), &data).map_err(|e| format!("{e:?}"))?;
+    channel.post_message(&message).map_err(|e| format!("{e:?}"))?;
+    channel.close();
+    Ok(())
+}
